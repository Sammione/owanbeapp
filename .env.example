# Copy this file to .env.local and fill in your own values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack → Settings → API Keys & Webhooks (use test keys first)
PAYSTACK_SECRET_KEY=sk_test_xxx

# The public address of your site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
